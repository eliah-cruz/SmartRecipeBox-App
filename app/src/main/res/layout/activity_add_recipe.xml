<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_gradient"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Form Back Button -->
        <Button
            android:id="@+id/btn_back"
            android:layout_width="wrap_content"
            android:layout_height="54dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_primary_button"
            android:text="◀ Back"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_form_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:text="@string/add_recipe_title"
            android:textColor="@color/text_primary"
            android:textSize="30sp"
            android:textStyle="bold" />

        <!-- Recipe Name Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Recipe Name"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="6dp"/>

        <EditText
            android:id="@+id/et_recipe_name"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="18dp"
            android:background="@drawable/input_field_background"
            android:textColorHint="@color/text_hint"
            android:hint="e.g. Garlic Noodles"
            android:inputType="textCapWords"
            android:padding="16dp"
            android:textColor="@color/text_primary"
            android:textSize="16sp" />

        <!-- Cook Time Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cook Time (Minutes)"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="6dp"/>

        <EditText
            android:id="@+id/et_cook_time"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="18dp"
            android:background="@drawable/input_field_background"
            android:textColorHint="@color/text_hint"
            android:hint="e.g. 25"
            android:inputType="number"
            android:padding="16dp"
            android:textColor="@color/text_primary"
            android:textSize="16sp" />

        <!-- Ingredients Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ingredients"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="6dp"/>

        <EditText
            android:id="@+id/et_ingredients"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="18dp"
            android:background="@drawable/input_field_background"
            android:gravity="top|start"
            android:textColorHint="@color/text_hint"
            android:hint="Separate items with commas"
            android:inputType="textMultiLine"
            android:minHeight="80dp"
            android:padding="16dp"
            android:textColor="@color/text_primary"
            android:textSize="16sp" />

        <!-- Tags Section with Checkboxes -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🏷️ Select Category Tags"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="8dp"/>

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:layout_marginBottom="12dp">

            <CheckBox
                android:id="@+id/cb_quick"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:text="⚡ Quick"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />

            <CheckBox
                android:id="@+id/cb_breakfast"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:text="🍳 Breakfast"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />

            <CheckBox
                android:id="@+id/cb_lunch"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:text="🍱 Lunch"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />

            <CheckBox
                android:id="@+id/cb_dinner"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:text="🍲 Dinner"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />

            <CheckBox
                android:id="@+id/cb_vegan"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:text="🥗 Vegan"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />

            <CheckBox
                android:id="@+id/cb_healthy"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:text="🍎 Healthy"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />

            <CheckBox
                android:id="@+id/cb_soup"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:text="🥣 Soup"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />

            <CheckBox
                android:id="@+id/cb_sweet"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:text="🍬 Sweet"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />

            <CheckBox
                android:id="@+id/cb_dessert"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:text="🍰 Dessert"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />

            <CheckBox
                android:id="@+id/cb_other"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:text="✏️ Other..."
                android:textColor="@color/text_primary"
                android:textSize="15sp" />
        </GridLayout>

        <!-- Hidden Custom Tag EditText (Revealed when 'Other' is checked) -->
        <EditText
            android:id="@+id/et_other_tags"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/input_field_background"
            android:textColorHint="@color/text_hint"
            android:hint="Type custom tags separated by commas"
            android:inputType="text"
            android:padding="16dp"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:visibility="gone" />

        <!-- Standard Button -->
        <Button
            android:id="@+id/btn_save_recipe"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="@drawable/bg_primary_button"
            android:text="@string/save_recipe"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>
</ScrollView>